{
  "manifest_version": 3,
  "name": "Phishing Website Detector",
  "version": "1.1",
  "description": "Detect phishing websites using Machine Learning",
  "permissions": ["tabs", "activeTab", "storage", "windows", "webNavigation"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}